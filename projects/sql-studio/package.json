{
    "name": "@yydb/sql-studio",
    "version": "0.0.1",
    "description": "SQL Studio — browser workbench + `sql` CLI",
    "type": "module",
    "license": "MPL-2.0",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "bin": {
        "sql": "./src/cli.ts"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./cli": {
            "types": "./src/create-cli.ts",
            "import": "./src/create-cli.ts",
            "node": "./src/create-cli.ts",
            "default": "./src/create-cli.ts"
        }
    },
    "files": [
        "src",
        "README.md"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "sql": "node ./src/cli.ts"
    },
    "dependencies": {
        "@yydb/sql-studio-protocol": "workspace:*",
        "cac": "^6.7.14",
        "@yydb/sql-studio-orm": "workspace:*",
        "@yydb/sql-studio-server": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.9.2"
    },
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public",
        "tag": "dev"
    }
}
