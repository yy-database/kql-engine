{
    "name": "@yydb/sqlite",
    "version": "0.1.0",
    "description": "SQLite driver for SQL Studio / sql-studio-orm",
    "type": "module",
    "license": "MPL-2.0",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./wasm": {
            "types": "./src/wasm.ts",
            "import": "./src/wasm.ts",
            "default": "./src/wasm.ts"
        },
        "./node": {
            "types": "./src/node.ts",
            "import": "./src/node.ts",
            "node": "./src/node.ts",
            "default": "./src/node.ts"
        }
    },
    "files": [
        "src",
        "README.md"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@yydb/sql-studio-orm": "workspace:*",
        "@yydb/sql-studio-protocol": "workspace:*"
    },
    "devDependencies": {
        "typescript": "^5.9.2"
    },
    "publishConfig": {
        "access": "public"
    }
}
